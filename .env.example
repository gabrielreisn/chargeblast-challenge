# Copy to .env.local and fill in. Never commit real keys.

# Payments data source: "local" (committed fixture, default) or "remote" (Stripe API).
PAYMENTS_SOURCE=local

# Stripe sandbox secret (sk_test_...) or restricted (rk_test_...) key with read access to
# PaymentIntents, Customers, Charges and PaymentMethods. Required for PAYMENTS_SOURCE=remote
# and `pnpm stripe:import`. Live keys are rejected.
STRIPE_SECRET_KEY=
