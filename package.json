    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
